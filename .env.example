# Payment QA Runner - Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# Admin bootstrap (created on first boot if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Admin_123!

# Security — install.sh / deploy.sh generate strong random values if missing
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-session-secret
ENCRYPTION_KEY=  # leave blank to auto-generate on deploy; Fernet key base64
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default; BOTH backend+worker must share the SAME path)
DATABASE_URL=sqlite:////data/payment_qa.db
# Postgres profile (docker compose --profile postgres):
# DATABASE_URL=postgresql+psycopg2://qa:qa@postgres:5432/payment_qa

# API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Same-Origin deploy (browser → :3000/api → backend) does NOT require public IP here.
# Localhost entries cover next dev + direct API debugging.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker / safety defaults (production-safe)
PLAYWRIGHT_MOCK=0
LIVE_TESTING_ENABLED=false
WORKER_POLL_INTERVAL_SEC=2
MAX_CONCURRENT_BROWSERS=1
SCREENSHOT_DIR=/data/screenshots
REPORT_DIR=/data/reports
LOG_DIR=/data/logs
SESSION_DIR=/data/sessions
BROWSER_DEBUG=0
SESSION_HEARTBEAT_STALE_SEC=30

# Optional SOCKS5 probe target after CONNECT
PROXY_TEST_URL=http://1.1.1.1/

# Frontend — Same-Origin by default (leave NEXT_PUBLIC_API_URL empty / unset).
# Browser calls http://SERVER:3000/api/* ; Next.js proxies to backend.
# Do NOT set NEXT_PUBLIC_API_URL for production Same-Origin deploy.
# NEXT_PUBLIC_API_URL=
APP_VERSION=1.3.1
